{
  "expo": {
    "name": "Jetzt",
    "slug": "jetzt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jetzt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/jetzt.icon",
      "bundleIdentifier": "app.jetzt.tagesassistent",
      "supportsTablet": false,
      "infoPlist": {
        "NSAlarmKitUsageDescription": "Damit dich Jetzt zu deiner geplanten Aufstehzeit weckt – auch im Stumm-Modus und wenn die App geschlossen ist.",
        "CFBundleDevelopmentRegion": "de",
        "CFBundleLocalizations": [
          "de"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.jetzt.tagesassistent",
      "adaptiveIcon": {
        "backgroundColor": "#1F7A57",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Jetzt",
      "shortName": "Jetzt",
      "lang": "de",
      "themeColor": "#1F7A57",
      "description": "Was sollte ich jetzt gerade tun?"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-no-push",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1F7A57",
          "sounds": [
            "./assets/sounds/sanft.wav",
            "./assets/sounds/glocke.wav",
            "./assets/sounds/klar.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jetzt nutzt deinen Standort, um dein Zuhause und weitere Orte festzulegen. Die Daten bleiben auf deinem Gerät.",
          "locationAlwaysAndWhenInUsePermission": "Mit „Immer“ erkennt Jetzt per Geofencing, wann du nach Hause kommst oder losgehst – auch wenn die App geschlossen ist. Es gibt keine dauerhafte Ortung und keine Weitergabe an Dritte.",
          "locationAlwaysPermission": "Mit „Immer“ erkennt Jetzt per Geofencing, wann du nach Hause kommst oder losgehst – auch wenn die App geschlossen ist.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false,
      "baseUrl": "/jetzt"
    }
  }
}
